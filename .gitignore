# CMake build output
/build/

# CMake local user overrides (machine-specific, never committed)
CMakeUserPresets.json

# Visual Studio / MSVC local state
.vs/
*.obj
*.pdb
*.exe
*.ilk
*.idb
*.exp
*.lib

# Personal files (so that the image does not get pushed to the repo, must be user specified)
*.bmp
*.jpg

# CLion / JetBrains: the shared IDE config lives in CMakePresets.json and the
# committed .run/ run configurations. The .idea/ folder is per-user machine
# state (it regenerates on open), so it is not committed.
.idea/

# CLion build trees for any non-preset CMake profiles.
cmake-build-*/
